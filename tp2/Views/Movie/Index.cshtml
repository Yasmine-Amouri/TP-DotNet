@model IEnumerable<tp2.Models.Movie>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>Index</title>
    </head>
    <body>
        <p>
            <a asp-action="Create">Create New</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Index"
                        asp-route-sortOrder="@ViewBag.NameSortParm"
                        asp-route-page="1"
                        asp-route-pageSize="@ViewBag.PageSize">
                        Nom
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                        asp-route-sortOrder="@ViewBag.NameSortParm"
                        asp-route-page="1"
                        asp-route-pageSize="@ViewBag.PageSize">
                        Genre
                        </a>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @item.Genre?.Name
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
        <hr />

        <div>
            <span>Page @ViewBag.CurrentPage / @ViewBag.TotalPages</span>

            @if ((int)ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                asp-route-sortOrder="@ViewBag.CurrentSort"
                asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                asp-route-pageSize="@ViewBag.PageSize">
                    Précédent
                </a>
            }

            @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
            {
                <a asp-action="Index"
                asp-route-sortOrder="@ViewBag.CurrentSort"
                asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                asp-route-pageSize="@ViewBag.PageSize">
                    Suivant
                </a>
            }
        </div>

    </body>
</html>
